// Prisma schema for AdPilot — Social Media Command Center.
// Stores Shopify OAuth sessions, connected Meta social accounts,
// and scheduled social media posts.
//
// For production, switch provider to "postgresql" and set DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Path comes from env so Railway can point it at the persistent volume
  // (/data). Local dev: DATABASE_URL="file:./dev.db" — see .env.example.
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken  String?
  refreshTokenExpires DateTime?
}

/// A connected Facebook Page (and linked Instagram Business account).
model SocialAccount {
  id           String   @id @default(cuid())
  shop         String
  platform     String   @default("facebook") // facebook | instagram
  pageId       String
  pageName     String
  accessToken  String
  tokenExpires DateTime?
  instagramId  String?
  createdAt    DateTime @default(now())

  posts ScheduledPost[]

  @@unique([shop, pageId])
}

// Meta OAuth user token (long-lived, ~60 days). Needed for Marketing API
// calls like /me/adaccounts — page tokens cannot access those endpoints.
model MetaUserToken {
  id          String   @id @default(cuid())
  shop        String   @unique
  accessToken String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A social media post — drafted, scheduled, published, or failed.
model ScheduledPost {
  id              String    @id @default(cuid())
  shop            String
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  content         String
  mediaUrls       String    @default("[]") // JSON array of media URLs
  mediaType       String    @default("post") // post | reel | video
  platforms       String    @default("[\"facebook\"]") // JSON array: facebook, instagram
  scheduledAt     DateTime?
  status          String    @default("draft") // draft | scheduled | publishing | published | failed
  publishedAt     DateTime?
  error           String?
  createdAt       DateTime  @default(now())
}

/// A connected Meta ad account (for running ads).
model AdAccount {
  id           String   @id @default(cuid())
  shop         String
  adAccountId  String   // Meta ad account ID (act_XXXX without the act_ prefix)
  adAccountName String
  accessToken  String
  currency     String   @default("USD")
  pixelId      String?  // Meta Pixel ID for conversion tracking
  createdAt    DateTime @default(now())

  campaigns Campaign[]

  audiences Audience[]

  @@unique([shop, adAccountId])
}

/// A full-funnel group: one-click 3-stage funnel (TOF/MOF/BOF).
model FunnelGroup {
  id             String   @id @default(cuid())
  shop           String
  adAccountId    String
  name           String
  totalDailyBudget Float
  country        String   @default("US")
  ageMin         Int      @default(25)
  ageMax         Int      @default(64)
  destinationUrl String?
  publishFee     Float?
  status         String   @default("draft") // draft | partial | active | failed
  error          String?
  createdAt      DateTime @default(now())

  campaigns Campaign[]
}

/// An ad campaign created through AdPilot.
model Campaign {
  id             String   @id @default(cuid())
  shop           String
  adAccountId    String
  adAccount      AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  funnelGroupId  String?
  funnelGroup    FunnelGroup? @relation(fields: [funnelGroupId], references: [id], onDelete: SetNull)
  funnelStage    String?  // TOF | MOF | BOF — set for funnel campaigns
  audienceDbId   String?  // Audience.id — when a saved audience was used
  audienceName   String?  // snapshot of the audience name at publish
  metaCampaignId String?  // Meta's campaign ID after publish
  metaAdSetId    String?
  metaAdId       String?
  name           String
  objective      String   // AWARENESS | TRAFFIC | ENGAGEMENT | SALES
  status         String   @default("draft") // draft | active | paused | failed
  dailyBudget    Float    // in account currency
  totalBudget    Float?
  startDate      DateTime?
  endDate        DateTime?
  headline       String?
  primaryText    String?
  description    String?
  imageUrl       String?
  destinationUrl String?
  cta            String?  // call-to-action button type
  adSetCount     Int      @default(1)
  creativeCount  Int      @default(1)
  publishFee     Float?   // total wallet fee charged at publish (USD)
  error          String?
  createdAt      DateTime @default(now())
}

/// A standalone audience created through Audience Manager.
/// (Funnel auto-creates its own audiences; those are not stored here.)
model Audience {
  id             String   @id @default(cuid())
  shop           String
  adAccountId    String
  adAccount      AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  metaAudienceId String?
  name           String
  type           String   // website | video | engagement | interest | lookalike
  subtype        String?  // Meta subtype used
  config         String   @default("{}") // JSON: retention, country, interests, etc.
  approxCount    Int?
  status         String   @default("active") // active | failed
  publishFee     Float?
  error          String?
  createdAt      DateTime @default(now())
}

/// A merchant's AdPilot wallet for ad spend topups.
model Wallet {
  id        String   @id @default(cuid())
  shop      String   @unique
  balance   Float    @default(0)
  currency  String   @default("USD")
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

/// A wallet transaction (topup, ad spend, refund).
model WalletTransaction {
  id          String   @id @default(cuid())
  shop        String
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Float    // positive for topup/refund, negative for spend
  type        String   // topup | ad_spend | refund
  description String?
  metaRef     String?  // reference to campaign or charge ID
  createdAt   DateTime @default(now())
}

/// Append-only log of billable/AI actions per shop — powers the admin report.
/// action: ai_generate | post_publish | post_schedule | ad_publish | audience_create | wallet_topup
/// agentName: which AI agent served it (ai_generate only; null otherwise).
/// app: owning app id — forward-looking for the central AI Hub (multi-app).
model ActivityLog {
  id         String   @id @default(cuid())
  shop       String
  action     String
  detail     String?
  feeCharged Float    @default(0)
  agentName  String?
  app        String   @default("adpilot")
  createdAt  DateTime @default(now())

  @@index([shop, createdAt])
  @@index([action, createdAt])
  @@index([agentName, createdAt])
}

/// A named AI agent: provider ref + assigned sectors + working-rules text.
/// Generation requests route by sector → agent (priority order) → provider,
/// with fallback to the next agent on failure. A MAIN agent (isMainAgent)
/// implicitly covers ALL sectors and is tried after specialized agents.
/// activeFrom/expiresAt support monthly subscription rotation (null = no
/// restriction; expired or not-yet-active agents are silently skipped).
/// Part of the portable AI layer (see app/lib/agents.server.ts); the owner
/// will extract this into a shared AI Hub package later.
model AiAgent {
  id            String    @id @default(cuid())
  name          String
  providerName  String    // must match a slot name in AI_PROVIDER_ORDER
  sectors       String    @default("all") // comma-separated, e.g. "caption,hashtag" or "all"
  rulesText     String?   // working-rules text extracted from uploaded PDF (cap 20000 chars)
  rulesFileName String?
  priority      Int       @default(0) // lower = tried first
  enabled       Boolean   @default(true)
  isMainAgent   Boolean   @default(false) // main orchestrator: covers all sectors; lowest priority wins if several flagged
  activeFrom    DateTime? // subscription start; null = no restriction
  expiresAt     DateTime? // subscription end; null = no restriction
  createdAt     DateTime  @default(now())

  @@index([enabled, priority])
}

/// An AI provider added from the admin panel (/app/admin → AI providers).
/// The API key is stored encrypted (AES-256-GCM, see app/lib/ai-providers.server.ts);
/// only the last 4 chars (keyHint) are ever shown in the UI.
/// Resolution order: enabled DB providers (sortOrder asc) FIRST, then env-var
/// providers from AI_PROVIDER_ORDER. A DB provider whose name matches an env
/// slot wins (the env slot is skipped). Part of the portable AI module.
model AiProvider {
  id           String   @id @default(cuid())
  name         String   @unique // lowercase slot name, e.g. "groq"
  type         String   // "openai" | "anthropic"
  keyEncrypted String   // AES-256-GCM, format "iv:ciphertext:tag" (hex)
  keyHint      String   // last 4 chars of the key, safe for display
  model        String
  baseUrl      String?  // openai-type only; custom endpoint (null = provider default)
  sortOrder    Int      @default(0) // lower = tried first
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([enabled, sortOrder])
}
