# Shopify App Credentials (from Partner Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://adpilot-production.up.railway.app
SCOPES=

# Meta App Credentials (from developers.facebook.com)
# Create a Meta app at https://developers.facebook.com/apps
# Add "Facebook Login" product with redirect URI:
#   https://adpilot-production.up.railway.app/auth/meta/callback
META_APP_ID=
META_APP_SECRET=

# Database (SQLite file — MUST live on Railway's persistent volume, or every
# deploy wipes all app data: agents, providers, wallets, scheduled posts).
# Railway service variable:  DATABASE_URL=file:/data/adpilot.db   (+ volume mounted at /data)
# Local dev:                 DATABASE_URL="file:./dev.db"
# DATABASE_URL=file:dev.sqlite
